{
  "name": "@vladonv/pm2-postgres",
  "version": "0.1.1",
  "description": "PM2 PostgreSQL Module (fork of pm2-hive/pm2-postgres, updated for PostgreSQL 10-18 / SCRAM auth support)",
  "main": "app.js",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "humanize": "0.0.9",
    "pg": "^8.23.0",
    "pmx": ">=0.5.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladonv/pm2-postgres.git"
  },
  "config": {
    "hostname": "localhost",
    "port": 5432,
    "username": "guest",
    "password": "guest",
    "database": "postgres"
  },
  "apps": [
    {
      "merge_logs": true,
      "max_memory_restart": "200M",
      "script": "app.js"
    }
  ],
  "author": "Keymetrics Inc. (original), vladonv (fork maintainer)",
  "license": "MIT",
  "devDependencies": {}
}
